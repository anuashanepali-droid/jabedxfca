{
	"name": "jabed-fca",
	"version": "0.2.1",
	"description": "Facebook Messenger API for Node.js — ntkhang fb-chat-api base, merged with ST-FCA, ws3-fca and Nexus-fCA features, plus duplicate-event filter and send queue",
	"scripts": {
		"test": "mocha",
		"lint": "./node_modules/.bin/eslint **.js",
		"prettier": "prettier utils.js src/* --write"
	},
	"keywords": [
		"facebook",
		"chat",
		"api",
		"fca",
		"fb-chat-api",
		"fb-chat-api-temp"
	],
	"author": "Avery, David, Maude, Benjamin, UIRI, NTKhang (rebuild), JABED VAO (jabed-fca)",
	"license": "MIT",
	"dependencies": {
		"axios": "^1.13.2",
		"axios-cookiejar-support": "^5.0.0",
		"bluebird": "^3.7.2",
		"https-proxy-agent": "^4.0.0",
		"mqtt": "^3.0.0",
		"npmlog": "^1.2.0",
		"request": "^2.53.0",
		"totp-generator": "^1.0.0",
		"tough-cookie": "^5.1.2",
		"uuid": "^11.1.0",
		"websocket-stream": "^5.5.0"
	},
	"engines": {
		"node": ">=16"
	},
	"devDependencies": {
		"eslint": "^7.5.0",
		"mocha": "^7.0.1",
		"prettier": "^1.11.1"
	},
	"eslintConfig": {
		"env": {
			"commonjs": true,
			"es2021": true,
			"node": true
		},
		"extends": "eslint:recommended",
		"parserOptions": {
			"ecmaVersion": 13
		},
		"rules": {
			"no-prototype-builtins": 0,
			"no-unused-vars": 1,
			"comma-dangle": 1,
			"no-redeclare": 0,
			"prefer-const": 1,
			"no-useless-escape": 0,
			"no-mixed-spaces-and-tabs": 0,
			"semi": 1,
			"no-useless-catch": 0,
			"no-empty": 0,
			"use-isnan": 0,
			"no-extra-semi": 1,
			"no-async-promise-executor": 0,
			"no-unreachable": 1,
			"valid-typeof": 0,
			"no-case-declarations": 0
		}
	},
	"main": "index.js",
	"files": [
		"index.js",
		"utils.js",
		"src/",
		"lib/",
		"LICENSE-MIT",
		"CREDITS.md",
		"README.md",
		"index.d.ts",
		"DOCS.md"
	],
	"types": "index.d.ts",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anuashanepali-droid/jabed-fca.git"
	},
	"bugs": {
		"url": "https://github.com/anuashanepali-droid/jabed-fca/issues"
	},
	"homepage": "https://github.com/anuashanepali-droid/jabed-fca#readme"
}